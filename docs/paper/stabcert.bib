% Stabilizer formalism  (Section 2)
% ---------------------------------------------------------------------------

% Both, and at the same place. Section 2 makes two claims in one sentence:
% it names the Gottesman-Knill theorem, whose source is this thesis, and then
% describes the tableau simulation -- "a tableau of 2n signed generators
% determines the state, and each gate updates it in polynomial time" -- which
% is Aaronson-Gottesman below.
% VERIFIED (record).
@phdthesis{gottesman1997,
  author = {Daniel Eric Gottesman},
  title  = {Stabilizer Codes and Quantum Error Correction},
  school = {California Institute of Technology},
  year   = {1997},
  eprint = {quant-ph/9705052},
  archivePrefix = {arXiv}
}

