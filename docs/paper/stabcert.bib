% ---------------------------------------------------------------------------
% Hayden--Preskill decoding  (Section 4.3)
% ---------------------------------------------------------------------------
%
% The Petz recovery literature that the instance family comes from -- Burri,
% Yoshida 2021, Hu and Zou, Beigi, Datta and Leditzky -- is not cited here.
% The paper never mentions Petz: its contribution is the decision procedure,
% and the recovery channel appears only as the source of fixtures. An uncited
% entry is padding, so those four live in docs/notes/NOVELTY_AUDIT.md, where
% they belong and where the reservation about the equation-by-equation
% comparison with Burri belongs with them. Restore them here only if a section
% of this paper discusses that literature.

% Decision taken: Section 4.3 means this work, not Yoshida 2021. It is the
% decoder whose canonical form is measurement-based, and of which the circuits
% verified here are the coherent counterpart. Yoshida 2021 remains above as a
% separate reference; it does not replace this one.
% VERIFIED (record).
@misc{yoshida2017efficient,
  author = {Beni Yoshida and Alexei Kitaev},
  title  = {Efficient Decoding for the {H}ayden--{P}reskill Protocol},
  year   = {2017},
  eprint = {1710.03363},
  archivePrefix = {arXiv}
}

